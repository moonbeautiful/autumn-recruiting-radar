{
  "schema_version": 1,
  "paths": {
    "input": "../runtime/inbox/jobs-input.json",
    "preferences": "../runtime/user-preferences.json",
    "state_dir": "../runtime/state"
  },
  "source_ranks": {
    "official": 400,
    "official_wechat": 300,
    "platform": 200
  },
  "matching": {
    "graduation_year_weight": 20,
    "role_weight": 40,
    "city_weight": 15,
    "employment_type_weight": 10,
    "company_preference_weight": 5,
    "industry_preference_weight": 5,
    "official_source_weight": 25,
    "platform_source_weight": 10,
    "allow_unknown_graduation_year": true,
    "nationwide_city_terms": [
      "全国",
      "多地",
      "不限城市"
    ]
  },
  "deduplication": {
    "key_fields": [
      "company",
      "title",
      "city",
      "graduation_year",
      "employment_type"
    ],
    "company_suffixes": [
      "股份有限公司",
      "有限责任公司",
      "有限公司"
    ],
    "title_noise_patterns": [
      "20\\d{2}届",
      "校园招聘",
      "校招",
      "应届生",
      "正式岗位"
    ],
    "volatile_query_prefixes": [
      "utm_",
      "spm",
      "session",
      "token",
      "sid",
      "from",
      "trace",
      "_t",
      "timestamp"
    ]
  },
  "change_detection": {
    "fields": [
      "company",
      "title",
      "city",
      "graduation_year",
      "employment_type",
      "salary",
      "published_at",
      "deadline",
      "source_status",
      "source_url",
      "source_name",
      "source_tier",
      "requirements",
      "requirement_keywords",
      "match_evidence",
      "highlights"
    ]
  },
  "deadline": {
    "auto_expire_on_past_deadline": true,
    "auto_expire_on_closed_status": true,
    "ending_soon_days": 3
  },
  "retention": {
    "expired_days": 180
  },
  "collector": {
    "command": [],
    "command_note": "默认留空是有意为之：本 Skill 的岗位发现由对话中的 AI 用宿主自带联网搜索实时完成（会话激活即自动增量搜集），零配置、零成本、不绑设备、GitHub 任何人克隆都能用。command 为空时，定时任务(schedule_task.py)只做截止归档与字段变化检测，不自行联网。仅当宿主提供了后台可执行、带联网能力的命令，且维护者接受其平台/成本约束时，才可在此填入模板 [python3,{skill_dir}/scripts/run_daily.py,...]，且不应随开源模板分发。",
    "working_directory": "..",
    "max_input_age_minutes": 180
  },
  "reports": {
    "chat_statuses": [
      "new",
      "changed"
    ]
  },
  "discovery": {
    "queue_source_order": [
      "platform_aggregator",
      "official",
      "official_wechat"
    ],
    "stream": {
      "deliver_per_company": true,
      "in_hiring_first": true,
      "first_batch_max_companies": 3,
      "max_companies_per_run": 12,
      "max_per_company": 5,
      "max_concurrent_lookups": 6,
      "ask_before_long_tail": true
    },
    "company_type_options": [
      "互联网大厂",
      "AI独角兽/大模型公司",
      "垂类/行业公司",
      "都要"
    ],
    "employer_anchors": {
      "note": "仅用于队列排序与偶发兜底；真实公司清单以运行时实时搜索为准，不写死。",
      "互联网大厂": [
        "字节跳动",
        "阿里巴巴",
        "腾讯",
        "美团",
        "拼多多",
        "百度",
        "京东",
        "网易",
        "小红书",
        "哔哩哔哩",
        "携程",
        "快手",
        "滴滴"
      ],
      "AI独角兽/大模型公司": [
        "商汤",
        "MiniMax",
        "月之暗面",
        "智谱",
        "阶跃星辰",
        "百川智能",
        "科大讯飞",
        "旷视"
      ],
      "垂类/行业公司": [
        "得物",
        "货拉拉",
        "喜马拉雅",
        "哈啰",
        "金山办公",
        "同程"
      ]
    }
  }
}
